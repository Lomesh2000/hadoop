# NASA Log Analytics Pipeline Environment Variables
# Defaults to local SQLite backend. Uncomment/modify for MySQL or Hadoop cluster execution.

DB_TYPE=sqlite
SQLITE_PATH=/tmp/nasalog_analytics.db

# Optional: Production MySQL Backend Settings
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=nasa_admin
# DB_PASSWORD=your_secure_password_here
# DB_NAME=nasadb

# Optional: Hadoop Cluster Environment Settings
# HADOOP_HOME=/usr/local/hadoop
# HDFS_INPUT_DIR=/data/nasa/input
# HDFS_OUTPUT_DIR=/data/nasa/output
# TOP_N_LIMIT=20
# MAX_MALFORMED_PCT=5.0
